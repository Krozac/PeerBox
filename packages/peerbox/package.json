{
  "name": "@peerbox/core",
  "version": "0.1.0",
  "description": "JavaScript networking and entity-component tools for multiplayer games",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Krozac/PeerBox.git",
    "directory": "packages/peerbox"
  },
  "homepage": "https://github.com/Krozac/PeerBox#readme",
  "bugs": { "url": "https://github.com/Krozac/PeerBox/issues" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "type": "module",  
  "files": ["dist", "types", "README.md", "LICENSE"],
  "dependencies": {
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "wrtc": "^0.4.7"
  },
  "peerDependenciesMeta": {
    "wrtc": { "optional": true }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./types/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs",
      "types": "./types/browser.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "require": "./dist/node.cjs",
      "types": "./types/node.d.ts"
    }
  },
  "types": "./types/index.d.ts",
  "scripts": {
    "build:esm": "vite build --config vite.config.esm.js",
    "build:cjs": "vite build --config vite.config.cjs.js",
    "build": "npm run build:esm && npm run build:cjs && node scripts/mergeDist.js",

    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "prepublishOnly": "npm run build"
}
  

}
